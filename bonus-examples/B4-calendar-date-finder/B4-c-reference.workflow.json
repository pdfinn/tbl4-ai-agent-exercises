      "name": "Compute Candidates",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [640, 460],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "c1", "name": "requested_date", "value": "={{ $json.requested_date }}", "type": "string" },
            { "id": "c2", "name": "busy_dates", "value": "={{ $json.busy_dates }}", "type": "array" },
