            { "id": "c4", "name": "cand_tue", "value": "={{ DateTime.fromISO($json.requested_date).plus({ days: (9 - DateTime.fromISO($json.requested_date).weekday) % 7 || 7 }).toFormat('yyyy-MM-dd') }}", "type": "string" }
