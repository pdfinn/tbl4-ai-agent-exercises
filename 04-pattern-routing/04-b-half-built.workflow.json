        },
        "options": {}
      }
    },
    {
      "id": "classify",
      "name": "Classify",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [640, 400],
      "parameters": { "promptType": "define", "text": "" }
    },
    {
      "id": "switch",
      "name": "Route",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [840, 400],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose", "version": 2 },
                "conditions": [{ "id": "r1", "leftValue": "={{ $json.text.trim() }}", "rightValue": "BILLING", "operator": { "type": "string", "operation": "contains" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "BILLING"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose", "version": 2 },
                "conditions": [{ "id": "r2", "leftValue": "={{ $json.text.trim() }}", "rightValue": "TECHNICAL", "operator": { "type": "string", "operation": "contains" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "TECHNICAL"
